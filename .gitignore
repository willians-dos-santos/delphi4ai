# ==============================================================================
# Delphi / RAD Studio .gitignore
# ==============================================================================

# Arquivos compilados e binários
*.dcu
*.dcp
*.bpl
*.bpi
*.lib
*.a
*.o
*.obj
*.exe
*.dll
*.so
*.dylib
*.apk
*.ipa

# Arquivos temporários, backups e travas da IDE
*.~*
*.bak
*.local
*.identcache
*.stat
*.tvsconfig
*.dsk

# Diretórios de histórico e recuperação gerados pela IDE
__history/
__recovery/

# Pastas de saída de compilação por plataforma/configuração
Win32/
Win64/
OSX32/
OSX64/
OSXARM64/
iOSDevice32/
iOSDevice64/
iOSSimulator/
Android/
Android64/
Linux64/

# Diretórios de modelagem / documentação gerados pelo Delphi
ModelSupport_*/

# Arquivos intermediários de depuração e linking
*.drc
*.map
*.rsm
*.tds
*.dres

# TestInsight / Frameworks de testes (opcional)
TestInsightSettings.ini

env.ini
